<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#8A001006" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#A82A6A39"
                android:centerColor="#7A123A20"
                android:endColor="#B0071D10" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#9A74F47A" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="4dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#36FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
