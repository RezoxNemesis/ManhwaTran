<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#99000905" />
        </shape>
    </item>
    <item
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#C52A6A39"
                android:centerColor="#B6123A20"
                android:endColor="#D006180D" />
            <stroke
                android:width="1dp"
                android:color="#A880FF82" />
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#52FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
