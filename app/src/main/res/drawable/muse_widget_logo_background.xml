<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#A0000B06" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#D42A6D38"
                android:endColor="#E0061A0D" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#A78BFF8B" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="6dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#43FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
